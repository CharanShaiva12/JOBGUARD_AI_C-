@model JobGuard.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-split-wrapper">
    <!-- Brand / Security Identity Side -->
    <div class="auth-brand-side">
        <div class="auth-brand-header">
            <span class="auth-brand-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                Security Platform
            </span>
            <h2 class="auth-brand-title">Recruitment Fraud Defense</h2>
            <p class="auth-brand-desc">
                Sign in to your JobGuard account to review job postings and assess suspicious offers.
            </p>


        </div>

        <div style="font-size: 0.8rem; color: #6b7280; position: relative; z-index: 2;">
            JobGuard AI &bull; Automated Fraud Detection Advisor System
        </div>
    </div>

    <!-- Form Side -->
    <div class="auth-form-side">
        <div class="auth-form-header">
            <h1 class="auth-form-title">Welcome back</h1>
            <p class="auth-form-subtitle">Enter your credentials to access your JobGuard account.</p>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert-box alert-danger-custom"></div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control-custom" type="email" placeholder="name@example.com" autofocus autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="input-with-toggle">
                    <input asp-for="Password" id="loginPasswordInput" class="form-control-custom" type="password" placeholder="Enter your password" autocomplete="current-password" />
                    <button type="button" class="pwd-toggle-btn" data-target="loginPasswordInput" aria-label="Toggle password visibility">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div style="margin-top: 1.75rem;">
                <button type="submit" class="btn-primary-action" style="width: 100%;">
                    Sign In to Account
                </button>
            </div>
        </form>

        <div style="margin-top: 1.75rem; text-align: center; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
            <p style="font-size: 0.875rem; color: var(--text-muted);">
                Don't have an account yet? 
                <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" style="font-weight: 600;">Create one here</a>
            </p>
        </div>
    </div>
</div>
