@model JobGuard.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="auth-split-wrapper">
    <!-- Brand / Security Identity Side -->
    <div class="auth-brand-side">
        <div class="auth-brand-header">
            <span class="auth-brand-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                Candidate Protection
            </span>
            <h2 class="auth-brand-title">Detect Recruitment Scams Before You Apply</h2>
            <p class="auth-brand-desc">
                Create your JobGuard account to review job postings and assess suspicious offers.
            </p>


        </div>

        <div style="font-size: 0.8rem; color: #6b7280; position: relative; z-index: 2;">
            JobGuard AI &bull; Automated Fraud Detection Advisor System
        </div>
    </div>

    <!-- Form Side -->
    <div class="auth-form-side">
        <div class="auth-form-header">
            <h1 class="auth-form-title">Create your account</h1>
            <p class="auth-form-subtitle">Register in seconds to start evaluating job opportunities.</p>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert-box alert-danger-custom"></div>

            <div class="form-group">
                <label asp-for="FullName" class="form-label">Full Name</label>
                <input asp-for="FullName" class="form-control-custom" placeholder="Jane Doe" autofocus autocomplete="name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control-custom" type="email" placeholder="name@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-with-toggle">
                        <input asp-for="Password" id="regPasswordInput" class="form-control-custom" type="password" placeholder="At least 8 chars" autocomplete="new-password" />
                        <button type="button" class="pwd-toggle-btn" data-target="regPasswordInput" aria-label="Toggle password visibility">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                    <div class="input-with-toggle">
                        <input asp-for="ConfirmPassword" id="regConfirmPasswordInput" class="form-control-custom" type="password" placeholder="Re-enter password" autocomplete="new-password" />
                        <button type="button" class="pwd-toggle-btn" data-target="regConfirmPasswordInput" aria-label="Toggle password visibility">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group" style="margin-top: 0.5rem;">
                <label style="display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.85rem; color: var(--text-secondary); cursor: pointer;">
                    <input asp-for="AcceptTerms" type="checkbox" style="margin-top: 0.25rem;" />
                    <span>I agree to the <a asp-controller="Legal" asp-action="Terms" target="_blank">Terms and Conditions</a> and acknowledge the <a asp-controller="Legal" asp-action="Privacy" target="_blank">Privacy Policy</a>.</span>
                </label>
                <span asp-validation-for="AcceptTerms" class="text-danger"></span>
            </div>

            <div style="margin-top: 1.5rem;">
                <button type="submit" class="btn-primary-action" style="width: 100%;">
                    Create Account
                </button>
            </div>
        </form>

        <div style="margin-top: 1.75rem; text-align: center; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
            <p style="font-size: 0.875rem; color: var(--text-muted);">
                Already have an account? 
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" style="font-weight: 600;">Sign in here</a>
            </p>
        </div>
    </div>
</div>
