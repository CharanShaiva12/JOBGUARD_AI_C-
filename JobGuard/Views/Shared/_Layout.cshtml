@{
    var pageController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home").ToLowerInvariant();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobGuard</title>
    <link rel="icon" type="image/svg+xml" href="~/images/jobguard-logo.svg" />
    <script>
        (function () {
            try { document.documentElement.setAttribute('data-theme', localStorage.getItem('JobGuard_Theme') || 'dark'); }
            catch { document.documentElement.setAttribute('data-theme', 'dark'); }
        })();
    </script>
    <link rel="stylesheet" href="~/css/jobguard.css" asp-append-version="true" />
</head>
<body class="page-@pageController" data-theme="dark">
    <!-- Collapsible left navigation rail -->
    <aside id="jobguardSidebar" class="jg-sidebar" aria-label="Main navigation">
        <button type="button" id="sidebarToggle" class="jg-sidebar-toggle" aria-label="Expand navigation" aria-expanded="false" title="Expand navigation">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
        <nav class="jg-sidebar-nav">
            <a asp-controller="Analysis" asp-action="Index" class="jg-sidebar-link" title="Analysis" aria-label="Analysis">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4M8 11h6M11 8v6"/></svg><span>Analysis</span>
            </a>
            <a asp-controller="Dashboard" asp-action="Index" class="jg-sidebar-link" title="Dashboard" aria-label="Dashboard">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="5" rx="1"/><rect x="13" y="10" width="8" height="11" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/></svg><span>Dashboard</span>
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Index" class="jg-sidebar-link" title="Admin" aria-label="Admin">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 20 6v5c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/><path d="m9 12 2 2 4-4"/></svg><span>Admin</span>
                </a>
            }
            <a asp-controller="About" asp-action="Index" class="jg-sidebar-link" title="About" aria-label="About">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7h.01"/></svg><span>About</span>
            </a>
        </nav>
    </aside>
    @Html.AntiForgeryToken()

    <!-- Navigation Header -->
    <header class="navbar-custom">
        <div class="nav-container">
            <a asp-controller="Home" asp-action="Index" class="brand-link" title="JobGuard Home">
                <img src="~/images/jobguard-logo.svg" alt="JobGuard Shield" class="brand-icon" />
                <span>JobGuard</span>
            </a>

            <nav class="nav-account-actions" aria-label="Account">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post" class="account-signout-form">
                        <button type="submit" class="account-signout" title="Sign out" aria-label="Sign out">
                            @if (User.IsInRole("Admin"))
                            {
                                <svg class="account-role-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 20 6v5c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/><path d="m9 12 2 2 4-4"/></svg>
                                <span class="account-role-label">Admin</span>
                            }
                            else
                            {
                                <svg class="account-role-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c.5-4.2 3.2-6.5 8-6.5s7.5 2.3 8 6.5"/></svg>
                                <span class="account-role-label">User</span>
                            }
                            <svg class="signout-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17l5-5-5-5M15 12H3M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6"/></svg>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="nav-item-link">Login</a>
                    <a asp-controller="Account" asp-action="Register" class="btn-primary-action btn-sm-custom">Register</a>
                }
            </nav>
        </div>
    </header>

    <!-- Main Container -->
    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <!-- Cookie Consent Banner -->
    <div id="cookieBanner" class="cookie-banner" role="dialog" aria-label="Cookie consent">
        <h4 style="font-size: 1.05rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.35rem;">Cookie & Privacy Preferences</h4>
        <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.85rem; line-height: 1.5;">
            JobGuard uses essential security cookies for authentication and anti-forgery verification. Optional cookies assist with remembering interface preferences.
        </p>
        <div class="cookie-actions">
            <button type="button" id="btnAcceptCookies" class="btn-primary-action btn-sm-custom">Accept All</button>
            <button type="button" id="btnRejectCookies" class="btn-secondary-action btn-sm-custom">Reject Optional</button>
            <a asp-controller="Legal" asp-action="Cookies" class="btn-secondary-action btn-sm-custom">Manage Preferences</a>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer-custom">
        <div class="footer-container">
            <div>
                <p style="font-size: 0.85rem; color: var(--text-muted);">
                    JobGuard &copy; @DateTime.UtcNow.Year - AI-Assisted Employment Fraud Detection Platform
                </p>
            </div>
            <ul class="footer-links">
                <li><a asp-controller="About" asp-action="Index">About</a></li>
                <li><a asp-controller="Legal" asp-action="Privacy">Privacy Policy</a></li>
                <li><a asp-controller="Legal" asp-action="Terms">Terms & Conditions</a></li>
                <li><button type="button" onclick="openCookiePreferences()">Cookie Settings</button></li>
            </ul>
        </div>
    </footer>

    <script src="~/js/jobguard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
