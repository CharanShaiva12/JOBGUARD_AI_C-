@{
    ViewData["Title"] = "Terms and Conditions";
}

<div style="max-width: 860px; margin: 0 auto;">
    <div class="card-panel">
        <div class="card-header-styled">
            <h1 class="card-title">Terms and Conditions</h1>
            <p class="card-subtitle">Last updated: October 2026 &bull; Service Version 1.0</p>
        </div>

        <div style="font-size: 0.925rem; color: #cbd5e1; line-height: 1.8;">
            <h3 style="font-size: 1.15rem; color: #f8fafc; margin: 1.25rem 0 0.5rem 0;">1. Acceptance of Terms</h3>
            <p>
                By creating an account or using JobGuard, you agree to these Terms and Conditions. If you do not agree, do not use the application.
            </p>

            <h3 style="font-size: 1.15rem; color: #f8fafc; margin: 1.25rem 0 0.5rem 0;">2. Automated Nature of Predictions</h3>
            <p>
                JobGuard provides automated statistical evaluations generated by a Machine Learning text classification pipeline. Predictions (including "Legitimate", "Fraudulent", and numeric risk scores) are probability estimates, not verified legal determinations or factual guarantees.
            </p>

            <h3 style="font-size: 1.15rem; color: #f8fafc; margin: 1.25rem 0 0.5rem 0;">3. User Responsibilities & Verification</h3>
            <p>
                Users must independently verify any prospective employer through authoritative channels, including official corporate domains, business registries, and telephone contact. Decisions to apply, interview, or reject an offer must not be made solely on the basis of a single JobGuard risk score.
            </p>

            <h3 style="font-size: 1.15rem; color: #f8fafc; margin: 1.25rem 0 0.5rem 0;">4. Permissible Use</h3>
            <p>
                You agree to submit only publicly available job postings or advertisements you have permission to evaluate. You agree not to attempt to disrupt, reverse-engineer, exploit, or bypass system security boundaries, authentication controls, or administrative panels.
            </p>

            <h3 style="font-size: 1.15rem; color: #f8fafc; margin: 1.25rem 0 0.5rem 0;">5. Limitation of Liability</h3>
            <p>
                JobGuard and its developers are not liable for any direct, indirect, incidental, or consequential damages resulting from reliance on model outputs, false positives, false negatives, or unavailable system components.
            </p>
        </div>
    </div>
</div>
