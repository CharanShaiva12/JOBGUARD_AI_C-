@{
    ViewData["Title"] = "Cookie Preferences";
}

<div style="max-width: 680px; margin: 0 auto;">
    <div class="card-panel">
        <div class="card-header-styled">
            <h1 class="card-title">Cookie Preferences & Consent</h1>
            <p class="card-subtitle">Manage how cookies and local preferences are stored on your device.</p>
        </div>

        <div style="margin-bottom: 1.5rem;">
            <div style="padding: 1rem; background-color: #0b1322; border-radius: 6px; border: 1px solid var(--border-subtle); margin-bottom: 1rem;">
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <strong style="color: #f8fafc; font-size: 0.95rem;">Essential Security Cookies</strong>
                        <p style="font-size: 0.8rem; color: #94a3b8; margin-top: 0.25rem;">
                            Required for authentication sessions, CSRF token validation, and account protection. These cannot be disabled.
                        </p>
                    </div>
                    <span class="badge-status badge-legitimate" style="font-size: 0.75rem;">Always Active</span>
                </div>
            </div>

            <div style="padding: 1rem; background-color: #0b1322; border-radius: 6px; border: 1px solid var(--border-subtle); margin-bottom: 1rem;">
                <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
                    <div>
                        <strong style="color: #f8fafc; font-size: 0.95rem;">Analytics & Performance (Optional)</strong>
                        <p style="font-size: 0.8rem; color: #94a3b8; margin-top: 0.25rem;">
                            Measures application interaction frequency. No third-party ad networks or external analytics trackers are used.
                        </p>
                    </div>
                    <input type="checkbox" id="prefAnalytics" style="transform: scale(1.3); margin-top: 4px; cursor: pointer;" />
                </div>
            </div>

            <div style="padding: 1rem; background-color: #0b1322; border-radius: 6px; border: 1px solid var(--border-subtle);">
                <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
                    <div>
                        <strong style="color: #f8fafc; font-size: 0.95rem;">Interface Preferences (Optional)</strong>
                        <p style="font-size: 0.8rem; color: #94a3b8; margin-top: 0.25rem;">
                            Remembers display preferences and form states across sessions.
                        </p>
                    </div>
                    <input type="checkbox" id="prefPreferences" style="transform: scale(1.3); margin-top: 4px; cursor: pointer;" />
                </div>
            </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 1rem;">
            <button type="button" id="btnSavePreferences" class="btn-primary-action">Save My Preferences</button>
        </div>
        <div id="prefSaveNotice" style="display: none; margin-top: 1rem;" class="alert-box alert-success-custom">
            Your cookie preferences have been updated and stored.
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const consentCookie = getCookie("JobGuard_ConsentStatus");
        if (consentCookie) {
            const parts = consentCookie.split("_");
            document.getElementById("prefAnalytics").checked = parts[0] === "true";
            document.getElementById("prefPreferences").checked = parts[1] === "true";
        }

        document.getElementById("btnSavePreferences").addEventListener("click", function () {
            const analytics = document.getElementById("prefAnalytics").checked;
            const preferences = document.getElementById("prefPreferences").checked;
            saveCookieConsent(analytics, preferences);

            const notice = document.getElementById("prefSaveNotice");
            notice.style.display = "block";
            setTimeout(() => { notice.style.display = "none"; }, 3500);
        });
    });
</script>
}
